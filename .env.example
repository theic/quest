# Dev's secrets: copy to .env.local in the main checkout (worktrees read it from there) and fill in.
# Never commit real values, and never put production's here: production's live in .env.production.local
# (the same keys, for @messagingquestbot and Supabase atjukklkmfwhmbbzxaod). `npm run env:check` checks both.

# mq_app on dev's Supabase project bglbnziyilxkxgzortuf (scripts/db-probe.ts finds the pooler and writes it).
DATABASE_URL=
# @TestPatrikBot's token. Dev's bot has no webhook: `npm run dev` polls it.
TELEGRAM_BOT_TOKEN=
# Any 16+ characters (scripts/init-secrets.ts makes one). Only production's webhook uses it.
TELEGRAM_WEBHOOK_SECRET=
# Needed with MODELS=openrouter (production's, and dev's when set so).
OPENROUTER_API_KEY=

# Optional
# Dev runs free on your Claude subscription unless set to openrouter: every model call through the Claude CLI the Agent
# SDK ships (Opus 5.5 and Sonnet 5.5), and voice heard by a Whisper on this laptop. The CLI logs in once with
# npm run claude:login (CLAUDE.md, "Production and dev").
# MODELS=openrouter
# CLAUDE_CLI_SEATS=manager=claude-sonnet-5-5
# Read public pages and search the web while the customer's Chrome is closed (Tavily). Unset: only their Chrome reads.
TAVILY_API_KEY=
TAVILY_CREDITS_PER_DAY=60
# Stripe's test keys only (sk_test_...): a dev agent refuses a live key. scripts/stripe-setup.ts writes the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Make a day short, to watch Quest rest at the day's limit (dollars; $5 unset).
# DAY_LIMIT_USD=0.2
# The Quest button and the live page need https: npm run dev opens a tunnel for them by itself. An https address of
# your own for the page (ending /glass) is used instead (CLAUDE.md, "Production and dev").
# MINI_APP_URL=
# Model overrides (apps/agent/src/config.ts has the defaults and why).
# MANAGER_MODEL=
# WRITER_MODEL=
